---
import siteConfig from '../../site.config.mjs';
import { getLocale, localizePath } from '../i18n/locales';
import { useTranslations } from '../i18n/ui';
import LanguageLinks from './LanguageLinks.astro';
import LanguageSelect from './LanguageSelect.astro';
import ThemeToggle from './ThemeToggle.astro';

const title = siteConfig.title;
const locale = getLocale(Astro.url);
const { t } = useTranslations(locale);
const home = localizePath('/', locale);

const menuItems = [
	{ name: t('nav.home'), link: home },
	{ name: t('nav.gallery'), link: localizePath('/collections/', locale) },
	{ name: t('nav.about'), link: localizePath('/about/', locale) },
];

// Black outline on light, white outline on dark; fills on hover.
const outlined =
	'border-2 border-black rounded-md hover:bg-black hover:text-white dark:border-white dark:hover:bg-white dark:hover:text-black transition-all duration-300';
---

<!--
	The full bar shows from `lg` (1024px) up. With the language and theme controls,
	and the longer Russian and Ukrainian labels, it no longer fits at `md`, so
	tablets use the menu button.
-->
<nav
	x-data="{ isOpen: false, scrolled: false }"
	@scroll.window="scrolled = window.scrollY > 50"
	class="fixed top-0 left-0 w-full z-50 transition-all duration-300"
	:class="scrolled ? 'py-3 bg-white shadow-sm dark:bg-neutral-950 dark:shadow-black/40' : 'py-5 bg-transparent'"
>
	<div class="container mx-auto flex justify-between items-center">
		<a href={home} id="logo" class="text-2xl md:text-4xl font-semibold tracking-tight">
			{title}
		</a>

		<div class="hidden lg:flex items-center space-x-6">
			{
				menuItems.map((item) => (
					<a
						href={item.link}
						class="nav-link relative after:content-[''] after:absolute after:left-0 after:bottom-[-2px] after:h-[2px] after:bg-black dark:after:bg-white after:w-0 hover:after:w-full transition-all"
					>
						{item.name}
					</a>
				))
			}

			<!-- Opens BookingModal, which listens for this event on the window. -->
			<button
				type="button"
				@click="$dispatch('open-booking')"
				class:list={[
					outlined,
					'px-5 py-2 text-sm font-medium transform hover:scale-105 active:scale-95',
				]}
			>
				{t('nav.book')}
			</button>

			<div class="flex items-center gap-1">
				<LanguageSelect />
				<ThemeToggle />
			</div>
		</div>

		<div class="flex items-center gap-1 lg:hidden">
			<ThemeToggle />
			<button
				@click="isOpen = !isOpen"
				type="button"
				aria-label={t('nav.menu')}
				aria-controls="mobile-menu"
				:aria-expanded="isOpen ? 'true' : 'false'"
				class="p-1 text-gray-800 focus:outline-none dark:text-gray-200"
			>
				<svg
					x-show="!isOpen"
					aria-hidden="true"
					class="h-6 w-6"
					fill="none"
					viewBox="0 0 24 24"
					stroke="currentColor"
				>
					<path
						stroke-linecap="round"
						stroke-linejoin="round"
						stroke-width="2"
						d="M4 6h16M4 12h16M4 18h16"></path>
				</svg>
				<svg
					x-show="isOpen"
					aria-hidden="true"
					class="h-6 w-6"
					fill="none"
					viewBox="0 0 24 24"
					stroke="currentColor"
				>
					<path
						stroke-linecap="round"
						stroke-linejoin="round"
						stroke-width="2"
						d="M6 18L18 6M6 6l12 12"></path>
				</svg>
			</button>
		</div>
	</div>

	<div
		id="mobile-menu"
		x-show="isOpen"
		x-cloak
		class="lg:hidden absolute top-full left-0 w-full bg-white shadow-md dark:bg-neutral-900 dark:shadow-black/40"
	>
		<div class="flex flex-col py-4 px-6 space-y-4">
			{
				menuItems.map((item) => (
					<a href={item.link} class="text-lg" @click="isOpen = false">
						{item.name}
					</a>
				))
			}

			<button
				type="button"
				@click="isOpen = false; $dispatch('open-booking')"
				class:list={[outlined, 'mt-2 w-full px-5 py-3 text-base font-medium']}
			>
				{t('nav.bookLong')}
			</button>

			<LanguageLinks />
		</div>
	</div>
</nav>
