---
import siteConfig from '../../site.config.mjs';

const title = siteConfig.title;
const base = import.meta.env.BASE_URL;
const safeBase = base.endsWith('/') ? base.slice(0, -1) : base;

const menuItems = [
	{ name: 'Home', link: base },
	{ name: 'Gallery', link: `${safeBase}/collections` },
	{ name: 'About', link: `${safeBase}/about` },
];
---

<nav
	x-data="{ isOpen: false, scrolled: false }"
	@scroll.window="scrolled = window.scrollY > 50"
	class="fixed top-0 left-0 w-full z-50 transition-all duration-300"
	:class="scrolled ? 'py-3 bg-white shadow-sm' : 'py-5 bg-transparent'"
>
	<div class="container mx-auto flex justify-between items-center">
		<a href={base} id="logo" class="text-2xl md:text-4xl font-semibold tracking-tight">
			{title}
		</a>

		<div class="hidden md:flex items-center space-x-8">
			{
				menuItems.map((item) => (
					<a
						href={item.link}
						class="nav-link relative after:content-[''] after:absolute after:left-0 after:bottom-[-2px] after:h-[2px] after:bg-black after:w-0 hover:after:w-full transition-all"
					>
						{item.name}
					</a>
				))
			}

			<!-- Opens BookingModal, which listens for this event on the window. -->
			<button
				type="button"
				@click="$dispatch('open-booking')"
				class="px-5 py-2 border-2 border-black rounded-md hover:bg-black hover:text-white transition-all duration-300 text-sm font-medium transform hover:scale-105 active:scale-95"
			>
				Book
			</button>
		</div>

		<button
			@click="isOpen = !isOpen"
			type="button"
			aria-label="Menu"
			aria-controls="mobile-menu"
			:aria-expanded="isOpen ? 'true' : 'false'"
			class="md:hidden text-gray-800 focus:outline-none"
		>
			<svg
				x-show="!isOpen"
				aria-hidden="true"
				class="h-6 w-6"
				fill="none"
				viewBox="0 0 24 24"
				stroke="currentColor"
			>
				<path
					stroke-linecap="round"
					stroke-linejoin="round"
					stroke-width="2"
					d="M4 6h16M4 12h16M4 18h16"></path>
			</svg>
			<svg
				x-show="isOpen"
				aria-hidden="true"
				class="h-6 w-6"
				fill="none"
				viewBox="0 0 24 24"
				stroke="currentColor"
			>
				<path
					stroke-linecap="round"
					stroke-linejoin="round"
					stroke-width="2"
					d="M6 18L18 6M6 6l12 12"></path>
			</svg>
		</button>
	</div>

	<div
		id="mobile-menu"
		x-show="isOpen"
		class="md:hidden absolute top-full left-0 w-full bg-white shadow-md"
	>
		<div class="flex flex-col py-4 px-6 space-y-4">
			{
				menuItems.map((item) => (
					<a href={item.link} class="text-lg" @click="isOpen = false">
						{item.name}
					</a>
				))
			}

			<button
				type="button"
				@click="isOpen = false; $dispatch('open-booking')"
				class="mt-2 w-full px-5 py-3 border-2 border-black rounded-md hover:bg-black hover:text-white transition-all duration-300 text-base font-medium"
			>
				Book a shoot
			</button>
		</div>
	</div>
</nav>
