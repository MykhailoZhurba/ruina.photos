---
/**
 * Language dropdown for the desktop bar. Every option is a real link to the same
 * page in another language, present in the HTML whether or not the menu is open,
 * so search engines can follow it. The mobile menu uses LanguageLinks instead.
 *
 * The Alpine attributes (`@click.outside`, `:aria-expanded`) must stay in
 * top-level markup: inside a `{ ... }` expression they are parsed as JSX, where
 * those names are invalid, and Prettier (the pre-commit hook) refuses the file.
 */
import { ChevronDown, Globe } from 'lucide-astro';
import { LOCALES, LOCALE_META, getLocale, localizePath } from '../i18n/locales';
import { useTranslations } from '../i18n/ui';

const current = getLocale(Astro.url);
const { t } = useTranslations(current);
const options = LOCALES.map((locale) => ({
	locale,
	href: localizePath(Astro.url.pathname, locale),
	isCurrent: locale === current,
	...LOCALE_META[locale],
}));
const buttonLabel = `${t('nav.language')}: ${LOCALE_META[current].name}`;
---

<div
	x-data="{ open: false }"
	@click.outside="open = false"
	@keydown.escape.window="open = false"
	class="relative"
>
	<button
		type="button"
		@click="open = !open"
		:aria-expanded="open ? 'true' : 'false'"
		aria-controls="language-menu"
		aria-label={buttonLabel}
		title={buttonLabel}
		class="inline-flex items-center gap-1 rounded-md px-2 py-1.5 text-sm font-medium text-gray-700 transition-colors hover:bg-black/5 hover:text-black dark:text-gray-300 dark:hover:bg-white/10 dark:hover:text-white"
	>
		<Globe size={16} aria-hidden="true" />
		<span>{LOCALE_META[current].short}</span>
		<ChevronDown size={14} aria-hidden="true" />
	</button>
	<ul
		id="language-menu"
		x-show="open"
		x-cloak
		x-transition.opacity
		class="absolute right-0 z-50 mt-2 w-44 overflow-hidden rounded-md border border-gray-200 bg-white py-1 shadow-lg dark:border-neutral-700 dark:bg-neutral-900"
	>
		{
			options.map((option) => (
				<li>
					<a
						href={option.href}
						hreflang={option.locale}
						lang={option.locale}
						aria-current={option.isCurrent ? 'true' : undefined}
						class:list={[
							'flex items-center justify-between px-4 py-2 text-sm transition-colors hover:bg-gray-100 dark:hover:bg-neutral-800',
							option.isCurrent && 'font-semibold',
						]}
					>
						<span>{option.name}</span>
						<span class="text-xs text-gray-500 dark:text-gray-400">{option.short}</span>
					</a>
				</li>
			))
		}
	</ul>
</div>
