---
/**
 * Light/dark switch. The theme itself is applied by the inline script in
 * MainLayout's <head> (before first paint, so there is no flash); this button
 * just calls it. The icon swaps through CSS, so it is right even before any
 * script runs.
 */
import { Moon, Sun } from 'lucide-astro';
import { getLocale } from '../i18n/locales';
import { useTranslations } from '../i18n/ui';

interface Props {
	class?: string;
}

const { class: className } = Astro.props;
const { t } = useTranslations(getLocale(Astro.url));
const label = t('theme.dark');
---

<button
	type="button"
	data-theme-toggle
	aria-pressed="false"
	aria-label={label}
	title={label}
	onclick="window.__toggleTheme()"
	class:list={[
		'inline-flex h-9 w-9 items-center justify-center rounded-md text-gray-700 transition-colors hover:bg-black/5 hover:text-black dark:text-gray-300 dark:hover:bg-white/10 dark:hover:text-white',
		className,
	]}
>
	<Moon size={20} class="dark:hidden" aria-hidden="true" />
	<Sun size={20} class="hidden dark:block" aria-hidden="true" />
</button>
