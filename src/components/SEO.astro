---
/**
 * All <head> SEO tags in one place: title, description, canonical URL,
 * robots directives, Open Graph / Twitter cards and optional JSON-LD.
 */
import { URL } from 'node:url';
import { getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import siteConfig from '../../site.config.mjs';

interface Props {
	title: string;
	description: string;
	/** Picture used for social/link previews. Cropped to 1200×630. */
	image?: ImageMetadata;
	imageAlt?: string;
	noindex?: boolean;
	jsonLd?: Record<string, unknown> | Record<string, unknown>[];
}

const { title, description, image, imageAlt, noindex = false, jsonLd } = Astro.props;

const origin = Astro.site ?? new URL(Astro.url.origin);

// One canonical URL per page, always with a trailing slash (that is what the host serves).
const { pathname } = Astro.url;
const hasFileExtension = /\.[a-z0-9]+$/i.test(pathname);
const canonicalPath = hasFileExtension || pathname.endsWith('/') ? pathname : `${pathname}/`;
const canonical = new URL(canonicalPath, origin).href;

let ogImage: { url: string; width: number; height: number } | undefined;
if (image) {
	const optimized = await getImage({
		src: image,
		width: 1200,
		height: 630,
		fit: 'cover',
		format: 'jpg',
		quality: 80,
	});
	ogImage = { url: new URL(optimized.src, origin).href, width: 1200, height: 630 };
}

const socialImageAlt = imageAlt ?? `${siteConfig.title} – photograph by ${siteConfig.owner}`;

// Escape "<" so the JSON can never close the <script> tag early.
const jsonLdString = jsonLd ? JSON.stringify(jsonLd).replace(/</g, '\\u003c') : undefined;
---

<title>{title}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonical} />
<meta
	name="robots"
	content={noindex ? 'noindex, nofollow' : 'index, follow, max-image-preview:large'}
/>

<meta property="og:type" content="website" />
<meta property="og:site_name" content={siteConfig.title} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
{
	ogImage && (
		<>
			<meta property="og:image" content={ogImage.url} />
			<meta property="og:image:width" content={String(ogImage.width)} />
			<meta property="og:image:height" content={String(ogImage.height)} />
			<meta property="og:image:alt" content={socialImageAlt} />
		</>
	)
}

<meta name="twitter:card" content={ogImage ? 'summary_large_image' : 'summary'} />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
{
	ogImage && (
		<>
			<meta name="twitter:image" content={ogImage.url} />
			<meta name="twitter:image:alt" content={socialImageAlt} />
		</>
	)
}

{jsonLdString && <script type="application/ld+json" set:html={jsonLdString} />}
