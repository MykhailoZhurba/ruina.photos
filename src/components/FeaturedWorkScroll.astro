---
import { ChevronDown } from 'lucide-astro';
import { getLocale } from '../i18n/locales';
import { useTranslations } from '../i18n/ui';

const { t } = useTranslations(getLocale(Astro.url));
---

<div
	id="featured-gallery-scroll"
	class="absolute bottom-10 left-0 right-0 flex justify-center transition-opacity duration-300"
>
	<button
		onclick="scrollToContent();"
		class="flex flex-col items-center text-gray-600 hover:text-gray-900 transition-colors hover:cursor-pointer dark:text-gray-400 dark:hover:text-gray-100"
		aria-label={t('hero.scroll')}
	>
		<span class="text-sm mb-2">{t('hero.featuredWork')}</span>
		<ChevronDown size={24} />
	</button>
</div>

<script is:inline>
	const scrollToContent = () => {
		window.scrollTo({
			top: window.innerHeight,
			behavior: 'smooth',
		});
	};

	document.addEventListener('DOMContentLoaded', () => {
		const button = document.getElementById('featured-gallery-scroll');

		window.addEventListener('scroll', () => {
			if (window.scrollY > 100) {
				button.style.opacity = 0;
				button.style.visibility = 'hidden';
			} else {
				button.style.visibility = 'visible';
				button.style.opacity = 1;
			}
		});
	});
</script>
