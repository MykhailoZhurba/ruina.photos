---
import '../styles/global.css';
// Fonts are bundled with the site (no requests to Google Fonts, so visitors' IP addresses stay private).
import '@fontsource/inter/300.css';
import '@fontsource/inter/400.css';
import '@fontsource/inter/500.css';
import '@fontsource/inter/600.css';
import '@fontsource/playfair-display/400.css';
import '@fontsource/playfair-display/500.css';
import '@fontsource/playfair-display/600.css';
import '@fontsource/playfair-display/700.css';
import '@fontsource/dancing-script/400.css';
import '@fontsource/dancing-script/500.css';
import '@fontsource/dancing-script/600.css';
import '@fontsource/dancing-script/700.css';
import type { ImageMetadata } from 'astro';
import siteConfig from '../../site.config.mjs';
import Footer from '../components/Footer.astro';
import NavBar from '../components/NavBar.astro';
import BookingModal from '../components/BookingModal.astro';
import SEO from '../components/SEO.astro';
import { featuredCollectionId, getImages } from '../data/imageStore';
import { getLocale } from '../i18n/locales';
import { seoFor } from '../i18n/seo';

interface Props {
	title?: string;
	description?: string;
	/** Picture for link previews. Defaults to a landscape photo from the featured collection. */
	image?: ImageMetadata;
	imageAlt?: string;
	noindex?: boolean;
	jsonLd?: Record<string, unknown> | Record<string, unknown>[];
}

const locale = getLocale(Astro.url);
const homeSeo = seoFor(locale).home;

const {
	title = homeSeo.title,
	description = homeSeo.description,
	image,
	imageAlt,
	noindex,
	jsonLd,
} = Astro.props;

const favicon = siteConfig.favicon;
const base = import.meta.env.BASE_URL;
const safeBase = base.endsWith('/') ? base.slice(0, -1) : base;

const featured = await getImages({ collection: featuredCollectionId });
const defaultImage = (featured.find((img) => img.src.width > img.src.height) ?? featured[0])?.src;
---

<html lang={locale} class="h-full">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<!--
			Theme, applied before first paint so a dark-mode visitor never sees a white
			flash. Follows the system setting until the visitor presses the switch; their
			choice is then kept in localStorage (it never leaves the device). Storage can be
			unavailable (private mode, blocked site data), so every access is guarded.
		-->
		<script is:inline>
			(() => {
				const root = document.documentElement;
				const media = window.matchMedia('(prefers-color-scheme: dark)');
				const stored = () => {
					try {
						return localStorage.getItem('theme');
					} catch {
						return null;
					}
				};
				const apply = (dark) => {
					root.classList.toggle('dark', dark);
					root.style.colorScheme = dark ? 'dark' : 'light';
					document
						.querySelectorAll('[data-theme-toggle]')
						.forEach((button) => button.setAttribute('aria-pressed', String(dark)));
				};
				const saved = stored();
				apply(saved ? saved === 'dark' : media.matches);

				// Switching after load fades between the two themes instead of snapping.
				// Browsers with view transitions cross-fade the whole page (images and
				// all); older ones ease the colours through a temporary class. Skipped
				// for visitors who ask for reduced motion.
				const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
				let fadeTimer;
				const applySmoothly = (dark) => {
					if (reduceMotion.matches) return apply(dark);
					if (document.startViewTransition) {
						document.startViewTransition(() => apply(dark));
						return;
					}
					root.classList.add('theme-fade');
					apply(dark);
					clearTimeout(fadeTimer);
					fadeTimer = setTimeout(() => root.classList.remove('theme-fade'), 500);
				};

				window.__toggleTheme = () => {
					const dark = !root.classList.contains('dark');
					try {
						localStorage.setItem('theme', dark ? 'dark' : 'light');
					} catch {
						// Not persisted, but still switches for this page.
					}
					applySmoothly(dark);
				};
				// Follow system changes live, unless the visitor has chosen explicitly.
				media.addEventListener('change', (event) => {
					if (!stored()) applySmoothly(event.matches);
				});
				// The buttons do not exist yet at this point; sync their state once they do.
				document.addEventListener('DOMContentLoaded', () => apply(root.classList.contains('dark')));
			})();
		</script>
		<link rel="icon" type="image/png" href={`${safeBase}/${favicon}`} />
		<meta name="generator" content={Astro.generator} />
		<SEO
			title={title}
			description={description}
			image={image ?? defaultImage}
			imageAlt={imageAlt}
			noindex={noindex}
			jsonLd={jsonLd}
		/>
	</head>
	<body>
		<NavBar />
		<main>
			<slot />
		</main>
		<Footer />
		<BookingModal />

		<script>
			// Alpine.js (drives the mobile menu) is bundled instead of loaded from a third-party CDN.
			import Alpine from 'alpinejs';

			declare global {
				interface Window {
					Alpine: typeof Alpine;
				}
			}

			window.Alpine = Alpine;
			Alpine.start();
		</script>
	</body>
</html>
